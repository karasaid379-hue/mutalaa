{
  "name": "@mutalaa/content-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "enums.json",
    "sql",
    "manifest.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@mutalaa/anchors": "workspace:*"
  },
  "devDependencies": {
    "@mutalaa/search": "workspace:*",
    "@mutalaa/test-vectors": "workspace:*"
  }
}
