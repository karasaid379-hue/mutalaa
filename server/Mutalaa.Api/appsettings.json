{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Mutalaa": {
    "Features": {
      "Editor": true,
      "Public": false
    },
    "Auth": {
      "DevAutoLogin": false
    },
    "Paths": {
      "RawDir": "data/raw",
      "SourcesDir": "pipeline/sources",
      "PacksDir": "data/packs",
      "TempDir": ".tmp/api"
    }
  }
}
