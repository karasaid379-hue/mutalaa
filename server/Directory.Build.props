<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet guvenlik denetimi (NU1901-NU1904): yeni yayimlanan bir bulgu bir gecede CI'i dusurmesin. Uyari gorunur kalir; NuGet paketleri elle guncellenir (Dependabot NuGet'te kapali, A08). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- InvariantGlobalization bilerek acilmaz (Backend API 2): NFC ve Turkce siralama testleri ICU'ya ihtiyac duyabilir. -->
  </PropertyGroup>

</Project>
