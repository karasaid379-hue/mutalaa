<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Mutalaa.Domain\Mutalaa.Domain.csproj" />
  </ItemGroup>

  <!-- Ortak test vektorleri ve ayet sayilari cikti klasorune kopyalanir (vectors\ ve data\). -->
  <ItemGroup>
    <None Include="..\..\..\shared\test-vectors\**\*.jsonl" Exclude="..\..\..\shared\test-vectors\node_modules\**" Link="vectors\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\shared\data\ayet-sayilari.json" Link="data\ayet-sayilari.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\packages\content-schema\enums.json" Link="data\enums.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\shared\data\ic-kesme.txt" Link="data\ic-kesme.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
