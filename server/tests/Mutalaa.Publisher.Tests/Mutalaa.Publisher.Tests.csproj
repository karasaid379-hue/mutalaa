<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Mutalaa.Publisher\Mutalaa.Publisher.csproj" />
  </ItemGroup>

  <!-- Manifest semasi, ornek manifest ve ortak enum listesi cikti klasorune kopyalanir (data\). -->
  <ItemGroup>
    <None Include="..\..\..\packages\content-schema\manifest.schema.json" Link="data\manifest.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\packages\content-schema\test\fixtures\manifest-ornek.json" Link="data\manifest-ornek.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\packages\content-schema\enums.json" Link="data\enums.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Paket DDL dosyalari ve paketler.json (K-44; PackDdlSmokeTests) data\sql\ altina kopyalanir. -->
    <None Include="..\..\..\packages\content-schema\sql\**" Link="data\sql\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
