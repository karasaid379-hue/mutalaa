<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Mutalaa.Api\Mutalaa.Api.csproj" />
  </ItemGroup>

  <!-- Domain.Tests destek dosyalari baglantili eklenir (kopya yok): kultur kapsami, enum JSON ve DDL okuyucusu. -->
  <ItemGroup>
    <Compile Include="..\Mutalaa.Domain.Tests\Support\CultureScope.cs" Link="Support\CultureScope.cs" />
    <Compile Include="..\Mutalaa.Domain.Tests\Support\EditorialDoc.cs" Link="Support\EditorialDoc.cs" />
    <Compile Include="..\Mutalaa.Domain.Tests\Support\EnumsJson.cs" Link="Support\EnumsJson.cs" />
  </ItemGroup>

  <!-- Yayin onizleme testleri Publisher.Tests'in sentetik icerik tohumunu baglantili dosya olarak kullanir (Publisher'a bagimlilik yok). -->
  <ItemGroup>
    <Compile Include="..\Mutalaa.Publisher.Tests\Support\EndToEndData.cs" Link="Support\EndToEndData.cs" />
  </ItemGroup>

  <!-- Ortak enum JSON'u cikti klasorune kopyalanir (data\enums.json). -->
  <ItemGroup>
    <None Include="..\..\..\packages\content-schema\enums.json" Link="data\enums.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tanzil fiksturu parcalari (EndToEndData; ham baytlar degismeden): data\tanzil\. -->
  <ItemGroup>
    <None Include="..\..\..\pipeline\tests\fixtures\tanzil\*-parca.txt" Link="data\tanzil\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
