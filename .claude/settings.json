{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "turkish",
  "plansDirectory": ".tmp/planlar",
  "autoMemoryEnabled": false,
  "enableArtifact": false,
  "env": {
    "PYTHONUTF8": "1",
    "ASPNETCORE_ENVIRONMENT": "Development",
    "DOTNET_ENVIRONMENT": "Development",
    "DOTNET_NOLOGO": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "TURBO_TELEMETRY_DISABLED": "1",
    "NEXT_TELEMETRY_DISABLED": "1",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash"
    ],
    "ask": [
      "Bash(eas build *)",
      "Bash(eas update *)",
      "PowerShell(eas build *)",
      "PowerShell(eas update *)",
      "Bash(git config --global *)",
      "PowerShell(git config --global *)",
      "Bash(dotnet tool install -g *)",
      "Bash(dotnet tool install --global *)",
      "PowerShell(dotnet tool install -g *)",
      "PowerShell(dotnet tool install --global *)",
      "Bash(uv python install *)",
      "Bash(uv tool install *)",
      "PowerShell(uv python install *)",
      "PowerShell(uv tool install *)",
      "Bash(npm install -g *)",
      "Bash(npm install --global *)",
      "Bash(npm i -g *)",
      "Bash(pnpm add -g *)",
      "Bash(pnpm add --global *)",
      "Bash(pnpm install -g *)",
      "Bash(pipx install *)",
      "Bash(dotnet workload install *)",
      "Bash(winget install *)",
      "Bash(choco install *)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(/data/raw/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(eas submit *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(dotnet nuget push *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(eas submit *)",
      "PowerShell(npm publish *)",
      "PowerShell(pnpm publish *)",
      "PowerShell(dotnet nuget push *)",
      "Read(**/s3.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/oturum-baslangici.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/klasor-bekcisi.mjs"
            ],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/metin-kurali.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
