    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.7",
